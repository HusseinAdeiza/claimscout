# Copy to .env and fill in, or export in your shell. Never commit real keys.

# GitHub token — optional, but raises the API rate limit from 60 to 5000 req/hr.
# Needs only public-repo read scope.
GH_TOKEN=

# Ranker (open-weight model). Defaults to NVIDIA's OpenAI-compatible endpoint.
# CLAIMSCOUT_API_KEY falls back to NVIDIA_API_KEY if unset.
CLAIMSCOUT_API_KEY=
CLAIMSCOUT_BASE_URL=https://integrate.api.nvidia.com/v1
CLAIMSCOUT_MODEL=meta/llama-3.2-11b-vision-instruct
